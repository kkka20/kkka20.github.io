---
import Card from "@/components/ui/Card.astro";
import { getTranslator, I18nKey } from "@/i18n";
import type { GiscusCommentConfig } from "@/types/commentConfig";

interface Props {
  config: GiscusCommentConfig;
}

const { config } = Astro.props;
const t = getTranslator();
---

<Card as="section" class="mt-5 px-5 py-7 tablet:mt-6 tablet:px-12 tablet:py-9" aria-labelledby="comments-title">
  <header class="mb-6 border-b border-border pb-4">
    <h2 class="m-0 text-xl font-bold" id="comments-title">{t(I18nKey.commentsTitle)}</h2>
  </header>

  <div
    data-giscus-comments
    data-repo={config.repo}
    data-repo-id={config.repoId}
    data-category={config.category}
    data-category-id={config.categoryId}
    data-mapping={config.mapping}
    data-strict={String(config.strict)}
    data-reactions-enabled={String(config.reactionsEnabled)}
    data-input-position={config.inputPosition}
    data-lang={config.lang}
  >
  </div>
</Card>

<script>
  const GISCUS_ORIGIN = "https://giscus.app";

  const currentTheme = () => (document.documentElement.dataset.theme === "dark" ? "dark" : "light");

  const syncGiscusTheme = () => {
    const theme = currentTheme();
    document.querySelectorAll<HTMLIFrameElement>("iframe.giscus-frame").forEach((frame) => {
      frame.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, GISCUS_ORIGIN);
    });
  };

  const setupGiscus = () => {
    const containers = document.querySelectorAll<HTMLElement>("[data-giscus-comments]");

    for (const container of containers) {
      if (container.dataset.giscusReady) continue;

      const repoId = container.dataset.repoId;
      if (!repoId) continue;

      container.dataset.giscusReady = "true";

      const script = document.createElement("script");
      script.src = `${GISCUS_ORIGIN}/client.js`;
      script.async = true;
      script.crossOrigin = "anonymous";
      script.setAttribute("data-repo", container.dataset.repo ?? "");
      script.setAttribute("data-repo-id", repoId);
      script.setAttribute("data-category", container.dataset.category ?? "");
      script.setAttribute("data-category-id", container.dataset.categoryId ?? "");
      script.setAttribute("data-mapping", container.dataset.mapping ?? "pathname");
      script.setAttribute("data-strict", container.dataset.strict ?? "false");
      script.setAttribute("data-reactions-enabled", container.dataset.reactionsEnabled ?? "true");
      script.setAttribute("data-emit-metadata", "0");
      script.setAttribute("data-input-position", container.dataset.inputPosition ?? "bottom");
      script.setAttribute("data-theme", currentTheme());
      script.setAttribute("data-lang", container.dataset.lang ?? "zh-CN");
      script.setAttribute("data-loading", "lazy");
      container.appendChild(script);
    }
  };

  setupGiscus();
  document.addEventListener("astro:page-load", setupGiscus);

  new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
